# Copy to infra/docker/.env. Generate unique production values; do not commit .env.
APP_SECRET=replace-with-a-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
DEFAULT_URI=https://example.com

# Use hexadecimal passwords so DATABASE_URL does not need URL escaping.
MYSQL_DATABASE=ns_ultimate
MYSQL_USER=ns_ultimate
MYSQL_PASSWORD=replace-with-a-long-hex-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-hex-password

# Absolute host paths to the deployment-specific JWT keys.
JWT_PRIVATE_KEY_FILE=/etc/ns-ultimate/keys/private.pem
JWT_PUBLIC_KEY_FILE=/etc/ns-ultimate/keys/public.pem
JWT_PASSPHRASE=

# Nginx binds to loopback by default for a host reverse proxy to terminate TLS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

INVENTORY_ENABLED=0
ALIYUN_SMS_DRY_RUN=1
