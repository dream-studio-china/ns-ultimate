{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Business/ProductMetadata",
  "title": "Product metadata",
  "description": "Product cover and display values stored directly in Product.metadata.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "cover": {
      "type": "string",
      "title": "Cover"
    },
    "soldOut": {
      "type": "boolean",
      "title": "Sold out",
      "default": false
    },
    "recommendLevel": {
      "type": "integer",
      "title": "Recommendation level",
      "minimum": 1,
      "maximum": 10
    },
    "weight": {
      "type": "number",
      "title": "Weight (kg)",
      "description": "Enter the product weight in kilograms. Leave blank if unknown.",
      "minimum": 0,
      "multipleOf": 0.01
    }
  },
  "required": []
}
