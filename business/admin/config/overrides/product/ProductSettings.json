{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Business/ProductSettings",
  "title": "Product settings",
  "description": "Product behavior settings stored in Product.settings.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "kitchenPrinterEnable": {
      "type": "boolean",
      "title": "Kitchen printer enabled"
    },
    "startSaleTime": {
      "type": "string",
      "title": "Sale start time",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "endSaleTime": {
      "type": "string",
      "title": "Sale end time",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    }
  },
  "required": []
}
