{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "Business/StoreSettings",
  "title": "Store Settings",
  "description": "Store-local configuration (Store.settings). Mirrors the core bundle schema and adds paymentRate.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "paymentRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "title": "Payment rate",
      "description": "Payment fee rate as a decimal fraction (0.006 = 0.6%).",
      "default": 0
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireAcceptance": {
          "type": "boolean",
          "description": "When true, Trade confirm waits for the Store acceptance fact.",
          "default": false
        },
        "requireInventory": {
          "type": "boolean",
          "description": "When true, StoreOrder awaits an inventory reservation before acceptance.",
          "default": false
        }
      },
      "required": []
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requireVerification": {
          "type": "boolean",
          "description": "When true, a fulfilled Store order must be verified before it can be completed.",
          "default": false
        }
      },
      "required": []
    },
    "printing": {
      "type": "object",
      "additionalProperties": false,
      "title": "Automatic printing",
      "description": "Enable and configure each legacy order-printing case independently.",
      "properties": {
        "order": {
          "type": "object", "title": "Standard order receipt", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Enabled", "default": false },
            "deviceUuid": { "type": "string", "title": "Printer device UUID", "minLength": 36, "maxLength": 36 },
            "templateUuid": { "type": "string", "title": "Printer template UUID", "minLength": 36, "maxLength": 36 },
            "copies": { "type": "integer", "title": "Copies", "minimum": 1, "maximum": 100, "default": 1 }
          },
          "required": []
        },
        "perItem": {
          "type": "object", "title": "Per-item ticket", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Enabled", "default": false },
            "deviceUuid": { "type": "string", "title": "Printer device UUID", "minLength": 36, "maxLength": 36 },
            "templateUuid": { "type": "string", "title": "Printer template UUID", "minLength": 36, "maxLength": 36 },
            "copies": { "type": "integer", "title": "Copies", "minimum": 1, "maximum": 100, "default": 1 }
          },
          "required": []
        },
        "filteredList": {
          "type": "object", "title": "Filtered item list", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Enabled", "default": false },
            "deviceUuid": { "type": "string", "title": "Printer device UUID", "minLength": 36, "maxLength": 36 },
            "templateUuid": { "type": "string", "title": "Printer template UUID", "minLength": 36, "maxLength": 36 },
            "copies": { "type": "integer", "title": "Copies", "minimum": 1, "maximum": 100, "default": 1 }
          },
          "required": []
        },
        "fullList": {
          "type": "object", "title": "Full item list", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Enabled", "default": false },
            "deviceUuid": { "type": "string", "title": "Printer device UUID", "minLength": 36, "maxLength": 36 },
            "templateUuid": { "type": "string", "title": "Printer template UUID", "minLength": 36, "maxLength": 36 },
            "copies": { "type": "integer", "title": "Copies", "minimum": 1, "maximum": 100, "default": 1 }
          },
          "required": []
        },
        "settlement": {
          "type": "object", "title": "Settlement receipt", "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "title": "Enabled", "default": false },
            "deviceUuid": { "type": "string", "title": "Printer device UUID", "minLength": 36, "maxLength": 36 },
            "templateUuid": { "type": "string", "title": "Printer template UUID", "minLength": 36, "maxLength": 36 },
            "copies": { "type": "integer", "title": "Copies", "minimum": 1, "maximum": 100, "default": 1 }
          }
        }
      }
    }
  },
  "required": []
}
