{
    "name": "crud-admin",
    "version": "0.9.2 beta",
    "description": "A configuration-driven enterprise admin framework and reference frontend for crud-skeleton, supporting metadata-driven CRUD, complex reporting, dynamic query DSLs, and domain-specific interfaces.",
    "author": "Lam K. <immane@163.com>",
    "scripts": {
        "test:unit": "vitest run",
        "test": "vitest run",
        "test:related": "vitest related --run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint --ext .js,.ts,.vue src",
        "type-check": "tsc --noEmit",
        "build": "npm run validate:configs && vite build",
        "build:prod": "npm run validate:configs && vite build --mode production",
        "build:stage": "npm run validate:configs && vite build --mode staging",
        "validate:configs": "vitest run tests/unit/easyadmin/configs/entity-config-schema.spec.js",
        "dev": "vite",
        "preview": "vite preview",
        "svgo": "svgo -f src/icons/svg --config=src/icons/svgo.yml",
        "test:ci": "npm run type-check && npm run test"
    },
    "main": "background.js",
    "dependencies": {
        "@codemirror/commands": "^6.10.4",
        "@codemirror/lang-css": "^6.3.1",
        "@codemirror/lang-html": "^6.4.11",
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-json": "^6.0.2",
        "@codemirror/lang-sql": "^6.10.0",
        "@codemirror/language": "^6.12.4",
        "@codemirror/state": "^6.7.1",
        "@codemirror/view": "^6.43.6",
        "@element-plus/icons-vue": "^2.3.2",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "axios": "0.34.0",
        "core-js": "3.6.5",
        "element-plus": "^2.9.7",
        "export-excel-csv": "^1.0.1",
        "file-saver": "^2.0.5",
        "get-value": "^3.0.1",
        "i": "^0.3.6",
        "ipfs-http-client": "^60.0.1",
        "is-absolute-url": "^3.0.3",
        "js-cookie": "3.0.8",
        "jsoneditor": "^10.4.3",
        "normalize.css": "7.0.0",
        "nprogress": "0.2.0",
        "numbro": "^2.3.2",
        "path-to-regexp": "9.0.0",
        "pinyin-pro": "^3.29.5",
        "prismjs": "^1.25.0",
        "qrcode": "^1.4.4",
        "vue": "^3.5.44",
        "vue-router": "^4.5.0",
        "vuex": "^4.1.0",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@babel/plugin-syntax-typescript": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-typescript": "^7.29.7",
        "@types/node": "^25.9.1",
        "@typescript-eslint/parser": "^8.26.0",
        "@vitejs/plugin-vue": "^5.2.1",
        "@vitejs/plugin-vue-jsx": "^4.1.2",
        "@vitest/coverage-v8": "^5.1.0",
        "@vue/compiler-sfc": "^3.5.13",
        "@vue/test-utils": "^2.4.6",
        "autoprefixer": "10.6.2",
        "babel-plugin-dynamic-import-node": "2.3.3",
        "chalk": "2.4.2",
        "connect": "3.6.6",
        "eslint": "^8.57.1",
        "eslint-plugin-vue": "^9.32.0",
        "jsdom": "^26.0.0",
        "mockjs": "1.0.1-beta3",
        "runjs": "4.3.2",
        "sass": "1.26.8",
        "serve-static": "2.2.1",
        "svgo": "2.8.4",
        "typescript": "^6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.1.0",
        "vue-eslint-parser": "^9.4.3"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions"
    ],
    "engines": {
        "node": ">=8.9",
        "npm": ">= 3.0.0"
    },
    "license": "MIT"
}
