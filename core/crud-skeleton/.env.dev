### Identity / Auth (from .env.example)
# JWT keys (paths to PEM files)
JWT_PRIVATE_KEY_PATH=var/jwt_dev_private.pem
JWT_PUBLIC_KEY_PATH=var/jwt_dev_public.pem
# Passphrase for the private key (keep secret)
JWT_PASSPHRASE=Z7r9Xw2qPt8sL1vH

# TTLs (seconds)
ACCESS_TOKEN_TTL=7200
REFRESH_TOKEN_TTL=31536000

# Refresh token hashing secret (keep secret)
REFRESH_TOKEN_SECRET=4f3b2c1a9d8e7f6a5b4c3d2e1f0a9b8c

# OTP / Redis
OTP_TTL=300
OTP_REDIS_DSN=redis://127.0.0.1:6379/0

# Aliyun SMS (leave keys empty for local/dev; DRY_RUN enabled)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_REGION=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=DemoApp
ALIYUN_SMS_TEMPLATE_LOGIN_OTP=SMS_0000001
ALIYUN_SMS_TEMPLATE_VERIFY_PHONE=SMS_0000002
ALIYUN_SMS_DRY_RUN=true

### WeChat (optional — leave empty to disable)
