# Test-only values. The PHPUnit bootstrap supplies an isolated SQLite database.
APP_DEBUG=1
APP_SECRET=integration-test-only
REFRESH_TOKEN_SECRET=integration-test-only
JWT_PRIVATE_KEY_PATH="${NS_PROJECT_ROOT}/core/crud-skeleton/tests/Identity/Security/test_private.pem"
JWT_PUBLIC_KEY_PATH="${NS_PROJECT_ROOT}/core/crud-skeleton/tests/Identity/Security/test_public.pem"
# Test-only WeChat credential encryption key (base64, 32 bytes). Not a secret.
WECHAT_CREDENTIAL_KEY=bnMtdWx0aW1hdGUtd2VjaGF0LXRlc3Qta2V5LTMyYiE=

# Test-only store WeChat webhook base URLs. The attempt UUID locator is appended.
WECHAT_STORE_PAY_NOTIFY_URL=https://example.test/api/v1/webhooks/wechat/notify
WECHAT_STORE_REFUND_NOTIFY_URL=https://example.test/api/v1/webhooks/wechat/notify
