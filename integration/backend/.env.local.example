# env-init generates random secrets instead of copying these placeholders.
APP_SECRET=replace-with-a-random-local-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-local-secret
# Generate a private stable key before managing printer accounts.
PRINTER_CONFIG_KEY=replace-with-a-random-local-secret
# Generate a private stable key before managing Huifu credentials.
HUIFU_CONFIG_KEY=replace-with-a-random-local-secret
